# Optional. Die Weboberfläche (http://localhost:8080) kann alles hier Aufgeführte einstellen und
# speichert es im Datenvolume (config.json); diese Werte haben Vorrang vor den Variablen hier.
# Diese Datei ist für den Betrieb ohne Weboberfläche (python -m checker --no-ui) oder zum Vorbelegen.
# Nach ".env" kopieren und ausfüllen; die ".env" niemals committen.
#
# Optional. The web UI can configure everything below and stores it in the data volume (config.json),
# which takes precedence. Use this file for a headless setup or to pre-fill the UI. Copy to ".env".

# --- Weboberfläche / Web UI ---------------------------------------------------------------
# Port auf Ihrem Computer für http://localhost:<HOST_PORT> (nur docker compose). Ändern, wenn 8080 belegt ist.
# Port on your machine (docker compose only). Change it if 8080 is taken.
HOST_PORT=8080
# Passwortschutz der Weboberfläche (HTTP Basic Auth, beliebiger Benutzername). Dringend empfohlen,
# wenn der Port über localhost hinaus freigegeben wird.
# Protects the web UI (basic auth, any username); strongly recommended before exposing the port.
UI_PASSWORD=

# --- Login (Stadt Wien Konto) ----------------------------------------------------------------
# Der Checker meldet sich mit einem unsichtbaren Browser an und erneuert die Anmeldung bei Bedarf.
# The checker logs in with a headless browser and re-logs in when the session expires.
MWT_USERNAME=
MWT_PASSWORD=

# Alternative ohne Zugangsdaten: Wert des Browser-Cookies
# "wswinteressentenportalSessionCookiewwwmeinwohnticketwien" nach manueller Anmeldung einfügen.
# Sitzungen laufen ab, daher regelmäßig erneuern; MWT_USERNAME/MWT_PASSWORD sind die bessere Wahl.
MWT_SESSION_COOKIE=

# --- Was beobachtet wird / What to watch -------------------------------------------------------
# Filter auf meinwohnticket.wien/wohnungen setzen und die URL aus der Adresszeile kopieren
# (oder einfach die Filterauswahl in der Weboberfläche verwenden).
# Set your filters on meinwohnticket.wien/wohnungen and copy the URL (or use the UI's filter picker).
MWT_SEARCH_URL=https://www.meinwohnticket.wien/wohnungen?anzahlRaeume=2-3&foerderungen=SMART_ZUSICHERUNG

# Prüfintervall in Minuten. Stündlich reicht: Wohnungen erscheinen schubweise, bleiben etwa zwei Tage
# online und werden nach Punkten vergeben, nicht nach Schnelligkeit. 1440 (einmal täglich) ist die Untergrenze.
# How often to check, in minutes. Hourly is plenty (batches, ~2 days online, point-based allocation).
CHECK_INTERVAL_MINUTES=60

# --- Benachrichtigungen (mindestens einen Kanal einrichten) / Notifications -------------------
# ntfy: ntfy-App installieren (Android/iOS/Web), ein langes zufälliges Thema abonnieren, hier eintragen.
# ntfy: install the app, subscribe to a long random topic, put it here.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=

# Telegram: Bot bei @BotFather anlegen, dem Bot eine Nachricht schicken, Chat-ID z. B. über @userinfobot.
# Telegram: create a bot with @BotFather, message it, get your chat id (e.g. via @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: Kanaleinstellungen -> Integrationen -> Webhooks. / Channel settings -> Integrations -> Webhooks.
DISCORD_WEBHOOK_URL=

# --- Sprache / Language -------------------------------------------------------------------------
# de oder en: Weboberfläche und Benachrichtigungstexte (auch im Kopf der Weboberfläche umschaltbar).
# de or en: web UI and notification texts (can also be switched in the web UI header).
LANGUAGE=de

# --- Verhalten / Behaviour ----------------------------------------------------------------------
# Nach der allerersten Prüfung eine Bestätigung mit der aktuellen Anzahl senden.
# Send a confirmation message with the current count on the very first run.
NOTIFY_ON_START=true
# Auch benachrichtigen, wenn eine Wohnung aus der Suche verschwindet.
# Also notify when a listing disappears from the search.
NOTIFY_ON_REMOVED=false
# Nach so vielen fehlgeschlagenen Prüfungen in Folge eine „Problem“-Benachrichtigung senden.
# Send a "problem" notification after this many consecutive failed checks.
FAILURE_NOTIFY_THRESHOLD=3
# DEBUG, INFO, WARNING
LOG_LEVEL=INFO
