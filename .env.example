# Optional. The web UI (http://localhost:8080) can configure everything below and stores it in
# the data volume (config.json), which takes precedence over these variables.
# Use this file if you prefer a headless setup (python -m checker --no-ui) or to pre-fill the UI.
# Copy it to ".env" and never commit that file.

# --- Web UI --------------------------------------------------------------------------------
# Port on your machine for http://localhost:<HOST_PORT> (docker compose only). Change it if 8080 is taken.
HOST_PORT=8080
# Protect the UI with a password (HTTP basic auth, any username). Strongly recommended if you
# expose the port beyond localhost.
UI_PASSWORD=

# --- Login (Stadt Wien Konto) -------------------------------------------------
# The checker logs in with a headless browser and re-logs in when the session expires.
MWT_USERNAME=
MWT_PASSWORD=

# Alternative without credentials: paste the value of the browser cookie
# "wswinteressentenportalSessionCookiewwwmeinwohnticketwien" after logging in manually.
# Sessions expire, so this needs manual refreshing; prefer MWT_USERNAME/MWT_PASSWORD.
MWT_SESSION_COOKIE=

# --- What to watch -------------------------------------------------------------
# Set your filters on meinwohnticket.wien/wohnungen and copy the URL from the address bar.
MWT_SEARCH_URL=https://www.meinwohnticket.wien/wohnungen?anzahlRaeume=2-3&foerderungen=SMART_ZUSICHERUNG

# How often to check, in minutes.
CHECK_INTERVAL_MINUTES=10

# --- Notifications (configure at least one) ----------------------------------------
# ntfy: install the ntfy app (Android/iOS/web), subscribe to a long random topic, put it here.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=

# Telegram: create a bot with @BotFather, send it a message, get your chat id (e.g. via @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: channel settings -> Integrations -> Webhooks.
DISCORD_WEBHOOK_URL=

# --- Language ----------------------------------------------------------------------------------
# de or en: web UI and notification texts (can also be switched in the web UI header).
LANGUAGE=de

# --- Behaviour ----------------------------------------------------------------------------
# Send a confirmation message with the current count on the very first run.
NOTIFY_ON_START=true
# Also notify when a listing disappears from the search.
NOTIFY_ON_REMOVED=false
# Send a "problem" notification after this many consecutive failed checks.
FAILURE_NOTIFY_THRESHOLD=3
# DEBUG, INFO, WARNING
LOG_LEVEL=INFO
